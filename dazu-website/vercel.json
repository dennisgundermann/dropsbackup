{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/.well-known/apple-app-site-association", "headers": [{ "key": "Content-Type", "value": "application/json" }] }
  ],
  "rewrites": [
    { "source": "/drop/:uuid", "destination": "/drop" },
    { "source": "/invite/:uid", "destination": "/drop" }
  ]
}
