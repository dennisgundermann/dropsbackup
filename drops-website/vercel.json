{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/drop/:uuid",
      "destination": "/drop"
    },
    {
      "source": "/invite/:uid",
      "destination": "/drop"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://dazuapp.com",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "https://dazuapp.com/support",
      "permanent": true
    },
    {
      "source": "/datenschutz",
      "destination": "https://dazuapp.com/datenschutz",
      "permanent": true
    },
    {
      "source": "/impressum",
      "destination": "https://dazuapp.com/impressum",
      "permanent": true
    }
  ]
}