{
  "rules": {

    "users": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() == true",
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",

        "isAdmin":        { ".write": false },
        "isBanned":       { ".write": false },
        "isPlusUser":     { ".write": false },
        // Server-aggregierter Feedback-Counter (Cloud Function onFeedbackVoteWritten).
        // Client darf nicht schreiben — sonst könnte User eigene Ratings inflationieren.
        // Admin-SDK bypassed Rules → Cloud Function kann trotzdem schreiben.
        "feedbackThumbs": { ".write": false }
      }
    },

    "friends": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        "$friendUID": {
          // Owner ($uid) darf seine eigene Liste managen.
          // Andere ($friendUID) dürfen NUR:
          //   - sich selbst löschen (Unfriend von der Gegenseite), ODER
          //   - sich eintragen, wenn $uid eine pending FriendRequest an $friendUID hat
          //     (= Accept-Flow: empfangender User schreibt beide Seiten atomisch)
          // Admins dürfen für Demo-Seeding alle Einträge beidseitig anlegen.
          ".write": "auth != null && (auth.uid == $uid || (auth.uid == $friendUID && (newData.val() === null || root.child('friendRequests').child(auth.uid).child($uid).exists())) || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
          ".validate": "newData.val() === true || newData.val() === null"
        }
      }
    },

    "friendRequests": {
      "$recipientUID": {
        ".read":  "auth != null && auth.uid == $recipientUID",
        "$senderUID": {
          ".write": "auth != null && (auth.uid == $senderUID || auth.uid == $recipientUID)",
          ".validate": "newData.hasChildren(['fromName','createdAt']) || newData.val() === null"
        }
      }
    },

    "drops": {
      ".read":  "auth != null",
      "$dropID": {
        ".write": "auth != null && (newData.child('userID').val() == auth.uid || data.child('userID').val() == auth.uid || newData.val() == null || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        "joinerIDs": {
          "$joinerUID": {
            ".write": "auth != null && auth.uid == $joinerUID"
          }
        }
      }
    },

    "dropins": {
      ".read":  "auth != null",
      "$dropID": {
        "$joinerUID": {
          ".write": "auth != null && (auth.uid == $joinerUID || root.child('drops').child($dropID).child('userID').val() == auth.uid || newData.val() == null)"
        }
      }
    },

    "joinRequests": {
      ".read":  "auth != null",
      "$dropID": {
        "$joinerUID": {
          ".write": "auth != null && (auth.uid == $joinerUID || root.child('drops').child($dropID).child('userID').val() == auth.uid || newData.val() == null)"
        }
      }
    },

    "phoneIndex": {
      ".read":  "auth != null",
      "$phone": {
        ".write": "auth != null && (newData.child('uid').val() == auth.uid || data.child('uid').val() == auth.uid || newData.val() == null)"
      }
    },

    "emailIndex": {
      ".read":  "auth != null",
      "$email": {
        ".write": "auth != null && (newData.child('uid').val() == auth.uid || data.child('uid').val() == auth.uid || newData.val() == null)"
      }
    },

    "usernameIndex": {
      ".read":  "auth != null",
      "$username": {
        ".write": "auth != null && (newData.child('uid').val() == auth.uid || data.child('uid').val() == auth.uid || newData.val() == null)"
      }
    },

    "deletedAccounts": {
      ".read":  "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || newData.val() == null)"
      }
    },

    "dropViews": {
      "$dropID": {
        ".read":  "auth != null && root.child('drops').child($dropID).child('userID').val() == auth.uid",
        "$viewerUID": {
          ".write": "auth != null && auth.uid == $viewerUID"
        }
      }
    },

    "joinerLocations": {
      "$dropID": {
        ".read":  "auth != null",
        "$joinerUID": {
          ".write": "auth != null && auth.uid == $joinerUID"
        }
      }
    },

    "reports": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() == true",
      "$reportID": {
        ".write": "auth != null && newData.child('reporterUID').val() == auth.uid"
      }
    },

    "nameChangeRequests": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() == true",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)"
      }
    },

    "friendshipPushSent": {
      ".read":  false,
      ".write": false
    },

    "dropInvitations": {
      "$recipientUID": {
        ".read":  "auth != null && auth.uid == $recipientUID",
        "$inviteID": {
          ".write": "auth != null && (newData.child('hostUID').val() == auth.uid || (newData.val() == null && auth.uid == $recipientUID))"
        }
      }
    },

    "config": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() == true"
    },

    "communityRequests": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() == true",
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)"
      }
    },

    "communities": {
      ".read":  "auth != null",
      "$communityID": {
        ".write": "auth != null && (data.child('creatorUID').val() == auth.uid || newData.child('creatorUID').val() == auth.uid || (!data.exists() && auth.uid == $communityID) || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
        "memberCount": {
          ".write":    "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },

    "communityMembers": {
      "$communityID": {
        ".read":  "auth != null && (root.child('communities').child($communityID).child('creatorUID').val() == auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() == true || root.child('communityMembers').child($communityID).child(auth.uid).exists())",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || root.child('communities').child($communityID).child('creatorUID').val() == auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)"
        }
      }
    },

    "communitiesByMember": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        "$communityID": {
          ".write": "auth != null && (auth.uid == $uid || root.child('communities').child($communityID).child('creatorUID').val() == auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)"
        }
      }
    },

    "userFeedback": {
      // Raw votes — privat (Anonymität schützt ehrliches Feedback).
      // Aggregat ist über /users/{uid}/feedbackThumbs öffentlich lesbar.
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() == true",
      "$ratedUID": {
        "$voteID": {
          // Rater darf eigene Votes anlegen/updaten/löschen. Niemand sonst.
          ".write":    "auth != null && (newData.val() === null || newData.child('raterUID').val() == auth.uid)",
          ".validate": "newData.child('vote').isString() && (newData.child('vote').val() == 'up' || newData.child('vote').val() == 'down') && newData.child('raterUID').val() == auth.uid"
        }
      }
    },

    "communityPushQueue": {
      "$communityID": {
        ".read":    "auth != null && root.child('communities').child($communityID).child('creatorUID').val() == auth.uid",
        ".write":   "auth != null && root.child('communities').child($communityID).child('creatorUID').val() == auth.uid",
        ".indexOn": ["sentAt"],
        "$pushID": {
          ".write": "auth != null && root.child('communities').child($communityID).child('creatorUID').val() == auth.uid"
        }
      }
    },

    "presence": {
      // Delayed-Presence-Feature (Opt-in).
      // Jeder eingeloggte User darf ALLE Einträge lesen — clientseitig wird
      // dann der 20-Min-Delay-Filter angewandt. Schreiben darf jeder nur
      // seinen eigenen Eintrag. Cloud Function purget Einträge > 4h.
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['lat','lng','updatedAt']) || newData.val() === null"
      }
    }
  }
}
